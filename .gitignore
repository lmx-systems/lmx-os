__pycache__/
*.pyc
.venv/
venv/
.venv-test/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
*.egg-info/
dist/
build/
.DS_Store

# Terraform (infra/) - local provider cache and state; real state lives
# in the S3 backend (infra/aws/versions.tf), never in this repo.
.terraform/
*.tfstate
*.tfstate.backup
*.tfplan

# Local tool settings (sandbox/IDE artifacts, never repo content)
.claude/

# Business documents & brand source creatives live in docs/ for convenience
# but are deliberately NOT versioned with the code (Sourabh's call, July
# 2026) - the shared drive is their source of truth. Product-embedded brand
# assets (dashboard/public/, client-portal/public/, driver-app/assets/) ARE
# committed. The roadmap user-story spreadsheet (docs/*.xlsx) is tracked on
# purpose, so it is deliberately NOT excluded here.
docs/*.pptx
docs/*.docx
docs/*.pdf
docs/*.zip
docs/LMX branding */
docs/~$*

# lmx-dwell/ is a separate analysis project that happens to sit inside this
# checkout. It is not part of LMX OS and must never be committed here, for a
# reason worth stating plainly: it holds the design partner's raw operational
# exports - their company name, their towns, their customers, invoice numbers
# and revenue - and **this repository is public**. Nothing in the rules above
# catches a .csv, so without this line a bare `git add .` publishes all of it.
# See the customer-naming rule in CLAUDE.md, which covers code, tests, fixtures
# and logs alike.
lmx-dwell/

